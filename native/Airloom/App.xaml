<Application
    x:Class="Airloom.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Default">
                    <SolidColorBrush x:Key="AppCanvasBrush" Color="#A9161720" />
                    <SolidColorBrush x:Key="PanelBrush" Color="#D421232E" />
                    <SolidColorBrush x:Key="InsetBrush" Color="#B7181A24" />
                    <SolidColorBrush x:Key="HairlineBrush" Color="#15FFFFFF" />
                    <SolidColorBrush x:Key="BrandBrush" Color="#BFB1FF" />
                    <SolidColorBrush x:Key="BrandSoftBrush" Color="#1FC5B9FF" />
                    <SolidColorBrush x:Key="AudioBrush" Color="#8DE1CF" />
                    <SolidColorBrush x:Key="AudioSoftBrush" Color="#188DE1CF" />
                    <SolidColorBrush x:Key="MutedBrush" Color="#A2A5B8" />
                    <SolidColorBrush x:Key="SpeakerBodyBrush" Color="#333540" />
                    <SolidColorBrush x:Key="SpeakerTopBrush" Color="#494B59" />
                    <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#8067DE" />
                    <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="#927BE6" />
                    <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="#A28FEB" />
                    <SolidColorBrush x:Key="TextOnAccentFillColorPrimaryBrush" Color="White" />
                    <SolidColorBrush x:Key="TextOnAccentFillColorSecondaryBrush" Color="#E6FFFFFF" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="AppCanvasBrush" Color="#BAF5F5FA" />
                    <SolidColorBrush x:Key="PanelBrush" Color="#EDFFFFFF" />
                    <SolidColorBrush x:Key="InsetBrush" Color="#E8F5F5FA" />
                    <SolidColorBrush x:Key="HairlineBrush" Color="#140E142D" />
                    <SolidColorBrush x:Key="BrandBrush" Color="#6A53CC" />
                    <SolidColorBrush x:Key="BrandSoftBrush" Color="#116A53CC" />
                    <SolidColorBrush x:Key="AudioBrush" Color="#127B68" />
                    <SolidColorBrush x:Key="AudioSoftBrush" Color="#10127B68" />
                    <SolidColorBrush x:Key="MutedBrush" Color="#686B80" />
                    <SolidColorBrush x:Key="SpeakerBodyBrush" Color="#E1DFEB" />
                    <SolidColorBrush x:Key="SpeakerTopBrush" Color="#C7C3D8" />
                    <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#8067DE" />
                    <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="#927BE6" />
                    <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="#A28FEB" />
                    <SolidColorBrush x:Key="TextOnAccentFillColorPrimaryBrush" Color="White" />
                    <SolidColorBrush x:Key="TextOnAccentFillColorSecondaryBrush" Color="#E6FFFFFF" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="HighContrast">
                    <SolidColorBrush x:Key="AppCanvasBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="PanelBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="InsetBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="HairlineBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="BrandBrush" Color="{ThemeResource SystemColorHighlightColor}" />
                    <SolidColorBrush x:Key="BrandSoftBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="AudioBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="AudioSoftBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="MutedBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="SpeakerBodyBrush" Color="{ThemeResource SystemColorButtonFaceColor}" />
                    <SolidColorBrush x:Key="SpeakerTopBrush" Color="{ThemeResource SystemColorButtonTextColor}" />
                    <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="{ThemeResource SystemColorHighlightColor}" />
                    <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="{ThemeResource SystemColorHighlightColor}" />
                    <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="{ThemeResource SystemColorHighlightColor}" />
                    <SolidColorBrush x:Key="TextOnAccentFillColorPrimaryBrush" Color="{ThemeResource SystemColorHighlightTextColor}" />
                    <SolidColorBrush x:Key="TextOnAccentFillColorSecondaryBrush" Color="{ThemeResource SystemColorHighlightTextColor}" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
            <Style x:Key="QuietLabelStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Foreground" Value="{ThemeResource MutedBrush}" />
            </Style>
            <Style x:Key="CardStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource PanelBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource HairlineBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="20" />
                <Setter Property="Padding" Value="22" />
            </Style>
            <Style x:Key="SubtleButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderBrush" Value="Transparent" />
                <Setter Property="CornerRadius" Value="10" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
