<Application
    x:Class="Airloom.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Native Windows 11 Fluent controls, unmodified: system accent,
                     native hover/press/disabled states and focus visuals. -->
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <!-- App brushes mirror the Fluent token values per theme. XAML can use the
                 Fluent keys directly; these exist for rows and states built in C++,
                 which resolve them against the window's actual theme. -->
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Default">
                    <SolidColorBrush x:Key="AppCanvasBrush" Color="Transparent" />
                    <SolidColorBrush x:Key="InkBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="MutedBrush" Color="#C5FFFFFF" />
                    <SolidColorBrush x:Key="FaintBrush" Color="#87FFFFFF" />
                    <SolidColorBrush x:Key="DisabledTextBrush" Color="#5DFFFFFF" />
                    <SolidColorBrush x:Key="SignalBrush" Color="{ThemeResource SystemAccentColorLight3}" />
                    <SolidColorBrush x:Key="SignalFillBrush" Color="{ThemeResource SystemAccentColorLight2}" />
                    <SolidColorBrush x:Key="SignalWashBrush" Color="{ThemeResource SystemAccentColorLight2}" Opacity="0.14" />
                    <SolidColorBrush x:Key="WarningBrush" Color="#FCE100" />
                    <SolidColorBrush x:Key="DangerBrush" Color="#FF99A4" />
                    <SolidColorBrush x:Key="RowRestBrush" Color="Transparent" />
                    <SolidColorBrush x:Key="RowSelectedBrush" Color="{ThemeResource SystemAccentColorLight2}" Opacity="0.12" />
                    <SolidColorBrush x:Key="CheckRestBrush" Color="#19000000" />
                    <SolidColorBrush x:Key="CheckStrokeBrush" Color="#8BFFFFFF" />
                    <SolidColorBrush x:Key="CheckOnBrush" Color="{ThemeResource SystemAccentColorLight2}" />
                    <SolidColorBrush x:Key="CheckGlyphBrush" Color="#000000" />
                    <SolidColorBrush x:Key="DividerBrush" Color="#15FFFFFF" />
                    <SolidColorBrush x:Key="GroupSurfaceBrush" Color="#08FFFFFF" />
                    <SolidColorBrush x:Key="GroupStrokeBrush" Color="#19000000" />
                    <!-- Redesign: route, pill and row surfaces. -->
                    <SolidColorBrush x:Key="AppSurfaceBrush" Color="#2B2B2B" />
                    <SolidColorBrush x:Key="AccentLineBrush" Color="{ThemeResource SystemAccentColorLight2}" Opacity="0.55" />
                    <SolidColorBrush x:Key="RouteIdleBrush" Color="#8BFFFFFF" />
                    <SolidColorBrush x:Key="NodeStrokeBrush" Color="#1AFFFFFF" />
                    <SolidColorBrush x:Key="PillRestBrush" Color="#0FFFFFFF" />
                    <SolidColorBrush x:Key="AvatarSelectedBrush" Color="{ThemeResource SystemAccentColorLight2}" Opacity="0.2" />
                    <SolidColorBrush x:Key="CautionWashBrush" Color="#433519" />
                    <SolidColorBrush x:Key="CriticalWashBrush" Color="#442726" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="AppCanvasBrush" Color="Transparent" />
                    <SolidColorBrush x:Key="InkBrush" Color="#E4000000" />
                    <SolidColorBrush x:Key="MutedBrush" Color="#9E000000" />
                    <SolidColorBrush x:Key="FaintBrush" Color="#72000000" />
                    <SolidColorBrush x:Key="DisabledTextBrush" Color="#5C000000" />
                    <SolidColorBrush x:Key="SignalBrush" Color="{ThemeResource SystemAccentColorDark2}" />
                    <SolidColorBrush x:Key="SignalFillBrush" Color="{ThemeResource SystemAccentColorDark1}" />
                    <SolidColorBrush x:Key="SignalWashBrush" Color="{ThemeResource SystemAccentColorDark1}" Opacity="0.10" />
                    <SolidColorBrush x:Key="WarningBrush" Color="#9D5D00" />
                    <SolidColorBrush x:Key="DangerBrush" Color="#C42B1C" />
                    <SolidColorBrush x:Key="RowRestBrush" Color="Transparent" />
                    <SolidColorBrush x:Key="RowSelectedBrush" Color="{ThemeResource SystemAccentColorDark1}" Opacity="0.08" />
                    <SolidColorBrush x:Key="CheckRestBrush" Color="#06000000" />
                    <SolidColorBrush x:Key="CheckStrokeBrush" Color="#72000000" />
                    <SolidColorBrush x:Key="CheckOnBrush" Color="{ThemeResource SystemAccentColorDark1}" />
                    <SolidColorBrush x:Key="CheckGlyphBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="DividerBrush" Color="#0F000000" />
                    <SolidColorBrush x:Key="GroupSurfaceBrush" Color="#80F9F9F9" />
                    <SolidColorBrush x:Key="GroupStrokeBrush" Color="#0F000000" />
                    <SolidColorBrush x:Key="AppSurfaceBrush" Color="#FBFBFB" />
                    <SolidColorBrush x:Key="AccentLineBrush" Color="{ThemeResource SystemAccentColorDark1}" Opacity="0.5" />
                    <SolidColorBrush x:Key="RouteIdleBrush" Color="#72000000" />
                    <SolidColorBrush x:Key="NodeStrokeBrush" Color="#17000000" />
                    <SolidColorBrush x:Key="PillRestBrush" Color="#0E000000" />
                    <SolidColorBrush x:Key="AvatarSelectedBrush" Color="{ThemeResource SystemAccentColorDark1}" Opacity="0.16" />
                    <SolidColorBrush x:Key="CautionWashBrush" Color="#FFF4CE" />
                    <SolidColorBrush x:Key="CriticalWashBrush" Color="#FDE7E9" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="HighContrast">
                    <SolidColorBrush x:Key="AppCanvasBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="InkBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="MutedBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="FaintBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="DisabledTextBrush" Color="{ThemeResource SystemColorGrayTextColor}" />
                    <SolidColorBrush x:Key="SignalBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="SignalFillBrush" Color="{ThemeResource SystemColorHighlightColor}" />
                    <SolidColorBrush x:Key="SignalWashBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="WarningBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="DangerBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="RowRestBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="RowSelectedBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="CheckRestBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="CheckStrokeBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="CheckOnBrush" Color="{ThemeResource SystemColorHighlightColor}" />
                    <SolidColorBrush x:Key="CheckGlyphBrush" Color="{ThemeResource SystemColorHighlightTextColor}" />
                    <SolidColorBrush x:Key="DividerBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="GroupSurfaceBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="GroupStrokeBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="AppSurfaceBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="AccentLineBrush" Color="{ThemeResource SystemColorHighlightColor}" />
                    <SolidColorBrush x:Key="RouteIdleBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="NodeStrokeBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="PillRestBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="AvatarSelectedBrush" Color="{ThemeResource SystemColorHighlightColor}" />
                    <SolidColorBrush x:Key="CautionWashBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="CriticalWashBrush" Color="{ThemeResource SystemColorWindowColor}" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <!-- Surfaces: Mica frame, one layer sheet, Fluent cards. No shadows at rest. -->
            <Style x:Key="SheetStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource LayerFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="8" />
            </Style>
            <Style x:Key="CardStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Padding" Value="20" />
            </Style>
            <!-- Settings rows follow Windows Settings: control-radius cards, 4px apart. -->
            <Style x:Key="SettingsCardStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="4" />
                <Setter Property="Padding" Value="16,12" />
                <Setter Property="MinHeight" Value="68" />
            </Style>

            <!-- Type follows the Windows 11 ramp: Caption 12, Body 14, BodyStrong 14,
                 Subtitle 20, Title 28. -->
            <Style x:Key="SectionHeaderStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextBlockStyle}">
                <Setter Property="Margin" Value="1,28,0,8" />
            </Style>
            <Style x:Key="CardTitleStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyTextBlockStyle}">
                <Setter Property="TextWrapping" Value="NoWrap" />
                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            </Style>
            <Style x:Key="CardDescriptionStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>
            <Style x:Key="SettingsGlyphStyle" TargetType="FontIcon">
                <Setter Property="FontSize" Value="20" />
                <Setter Property="Width" Value="20" />
                <Setter Property="Margin" Value="4,0,16,0" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
            </Style>
            <Style x:Key="FigureLabelStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                <Setter Property="TextWrapping" Value="NoWrap" />
            </Style>
            <Style x:Key="FigureValueStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyTextBlockStyle}">
                <Setter Property="TextWrapping" Value="NoWrap" />
                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            </Style>

            <!-- Button content keeps foreground inheritance so native state brushes apply. -->
            <Style x:Key="ButtonLabelStyle" TargetType="TextBlock">
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="TextWrapping" Value="NoWrap" />
            </Style>
            <Style x:Key="ButtonGlyphStyle" TargetType="FontIcon">
                <Setter Property="FontSize" Value="16" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

            <!-- Button hierarchy: every family is a native WinUI style with layout-only
                 setters. Accent and hover/press colours stay the system's. -->
            <Style x:Key="PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource AccentButtonStyle}">
                <Setter Property="MinWidth" Value="120" />
                <Setter Property="Padding" Value="16,6" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
            </Style>
            <Style x:Key="SecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                <Setter Property="MinWidth" Value="96" />
                <Setter Property="Padding" Value="12,5,12,6" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
            </Style>
            <Style x:Key="CompactButtonStyle" TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
                <Setter Property="MinWidth" Value="72" />
            </Style>
            <Style x:Key="QuietButtonStyle" TargetType="Button" BasedOn="{StaticResource SubtleButtonStyle}">
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="Padding" Value="11,5,11,6" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
            </Style>
            <Style x:Key="IconButtonStyle" TargetType="Button" BasedOn="{StaticResource SubtleButtonStyle}">
                <Setter Property="Width" Value="36" />
                <Setter Property="Height" Value="32" />
                <Setter Property="MinWidth" Value="36" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
            </Style>
            <Style x:Key="TitleBarButtonStyle" TargetType="Button" BasedOn="{StaticResource SubtleButtonStyle}">
                <Setter Property="MinWidth" Value="40" />
                <Setter Property="Height" Value="36" />
                <Setter Property="Padding" Value="10,0" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
            </Style>
            <!-- A receiver is a full-width subtle row: native hover and press fills,
                 a check indicator, and the selected tint set from the snapshot. -->
            <Style x:Key="ReceiverRowStyle" TargetType="Button" BasedOn="{StaticResource SubtleButtonStyle}">
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="Padding" Value="10,10,6,10" />
                <Setter Property="MinHeight" Value="60" />
                <Setter Property="CornerRadius" Value="6" />
            </Style>
            <!-- Row-level icon actions (members, more): 32 px square, subtle. -->
            <Style x:Key="RowIconButtonStyle" TargetType="Button" BasedOn="{StaticResource SubtleButtonStyle}">
                <Setter Property="Width" Value="32" />
                <Setter Property="Height" Value="32" />
                <Setter Property="MinWidth" Value="32" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
            </Style>
            <!-- The one primary action: a 44 px accent pill with a fixed slot, so the
                 dock never reflows when its label or icon changes. -->
            <Style x:Key="CastButtonStyle" TargetType="Button" BasedOn="{StaticResource AccentButtonStyle}">
                <Setter Property="Height" Value="44" />
                <Setter Property="MinWidth" Value="164" />
                <Setter Property="Padding" Value="22,0" />
                <Setter Property="CornerRadius" Value="22" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
            </Style>
            <Style x:Key="DockButtonStyle" TargetType="Button" BasedOn="{StaticResource SubtleButtonStyle}">
                <Setter Property="Height" Value="36" />
                <Setter Property="MinWidth" Value="88" />
                <Setter Property="Padding" Value="12,0" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
            </Style>
            <Style x:Key="StatTermStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorTertiaryBrush}" />
                <Setter Property="TextWrapping" Value="NoWrap" />
            </Style>
            <Style x:Key="StatValueStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                <Setter Property="TextWrapping" Value="NoWrap" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
