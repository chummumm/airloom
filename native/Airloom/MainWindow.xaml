<Window
    x:Class="Airloom.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Airloom">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>
    <Grid x:Name="LayoutRoot" Background="{ThemeResource AppCanvasBrush}"
          Loaded="OnLoaded" ActualThemeChanged="OnActualThemeChanged">
        <Grid.RowDefinitions>
            <RowDefinition Height="52" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid x:Name="TitleDragRegion" Background="Transparent" Padding="28,0,160,0">
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <Grid Width="25" Height="25" AutomationProperties.AccessibilityView="Raw">
                    <Rectangle Width="4" Height="10" RadiusX="2" RadiusY="2" Fill="{ThemeResource BrandBrush}" HorizontalAlignment="Left" />
                    <Rectangle Width="4" Height="22" RadiusX="2" RadiusY="2" Fill="{ThemeResource BrandBrush}" />
                    <Rectangle Width="4" Height="16" RadiusX="2" RadiusY="2" Fill="{ThemeResource BrandBrush}" HorizontalAlignment="Right" />
                </Grid>
                <TextBlock Text="Airloom" FontFamily="Segoe UI Variable Display" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />
                <Border Background="{ThemeResource BrandSoftBrush}" CornerRadius="5" Padding="6,3" Margin="3,0,0,0">
                    <TextBlock Text="0.2.0" Foreground="{ThemeResource BrandBrush}" FontSize="9" FontWeight="SemiBold" CharacterSpacing="70" />
                </Border>
            </StackPanel>
        </Grid>

        <ScrollViewer x:Name="HomeScrollViewer" Grid.Row="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" Padding="0,0,0,12">
            <Grid x:Name="PageContent" MaxWidth="1380" Margin="30,20,30,20" RowSpacing="20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Margin="2,0,2,4" ColumnSpacing="24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="7">
                        <TextBlock Text="让声音，抵达房间。" FontSize="32" FontWeight="SemiBold" CharacterSpacing="-30" />
                        <TextBlock Text="把电脑上的声音，交给你喜欢的扬声器。" FontSize="14" Foreground="{ThemeResource MutedBrush}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                        <Border Background="{ThemeResource PanelBrush}" BorderBrush="{ThemeResource HairlineBrush}" BorderThickness="1" CornerRadius="18" Padding="12,8">
                            <StackPanel Orientation="Horizontal" Spacing="7">
                                <Ellipse x:Name="StatusDot" Width="6" Height="6" Fill="{ThemeResource MutedBrush}" />
                                <TextBlock x:Name="StatusBadge" Text="等待连接" FontSize="12" AutomationProperties.LiveSetting="Polite" />
                            </StackPanel>
                        </Border>
                        <Button x:Name="SettingsButton" Style="{StaticResource SubtleButtonStyle}" Width="38" Height="38" Click="OnOpenSettings" AutomationProperties.Name="设置" ToolTipService.ToolTip="设置与更新">
                            <FontIcon Glyph="&#xE713;" FontSize="18" />
                        </Button>
                    </StackPanel>
                </Grid>

                <InfoBar x:Name="ErrorBanner" Grid.Row="1" IsOpen="False" IsClosable="False" Severity="Error" Title="连接需要处理" Message="">
                    <InfoBar.ActionButton>
                        <Button x:Name="RetryButton" Content="重试" Click="OnRetry" />
                    </InfoBar.ActionButton>
                </InfoBar>

                <Grid Grid.Row="2" ColumnSpacing="20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="296" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Style="{StaticResource CardStyle}" Padding="18,20,18,18" MinHeight="432">
                        <Grid RowSpacing="18">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid>
                                <StackPanel Spacing="4" Margin="4,0,48,0">
                                    <TextBlock Text="附近的扬声器" FontSize="17" FontWeight="SemiBold" />
                                    <TextBlock x:Name="DeviceCount" Text="在同一个网络中寻找" Style="{StaticResource QuietLabelStyle}" />
                                </StackPanel>
                                <Button x:Name="RefreshButton" HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource SubtleButtonStyle}" Width="34" Height="34" Click="OnRefresh" AutomationProperties.Name="重新发现扬声器" ToolTipService.ToolTip="重新发现">
                                    <FontIcon Glyph="&#xE72C;" FontSize="16" />
                                </Button>
                            </Grid>

                            <Grid Grid.Row="1" MinHeight="266">
                                <ScrollViewer MaxHeight="392" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                    <StackPanel x:Name="DeviceCards" Spacing="9" />
                                </ScrollViewer>
                                <StackPanel x:Name="DevicesEmptyState" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="16" Margin="12,20">
                                    <Grid Width="80" Height="80" AutomationProperties.AccessibilityView="Raw">
                                        <Ellipse Stroke="{ThemeResource HairlineBrush}" StrokeThickness="1" />
                                        <Ellipse Width="54" Height="54" Stroke="{ThemeResource BrandBrush}" StrokeThickness="1" Opacity="0.3" />
                                        <FontIcon Glyph="&#xE93E;" FontSize="26" Foreground="{ThemeResource BrandBrush}" />
                                    </Grid>
                                    <StackPanel Spacing="7">
                                        <TextBlock x:Name="EmptyDeviceTitle" Text="还没有发现扬声器" FontSize="14" FontWeight="SemiBold" TextAlignment="Center" />
                                        <TextBlock x:Name="EmptyDeviceDescription" Text="让电脑和 HomePod 连接同一网络，&#x0a;然后点右上角重新发现。" FontSize="12" Foreground="{ThemeResource MutedBrush}" TextAlignment="Center" TextWrapping="Wrap" LineHeight="20" />
                                    </StackPanel>
                                    <Button Content="管理设备显示" Click="OnOpenSettings" Style="{StaticResource SubtleButtonStyle}" />
                                    <ProgressRing x:Name="DiscoveryRing" IsActive="False" Width="20" Height="20" Visibility="Collapsed" />
                                </StackPanel>
                            </Grid>

                            <Border Grid.Row="2" CornerRadius="12" Background="{ThemeResource InsetBrush}" Padding="12">
                                <StackPanel Orientation="Horizontal" Spacing="9">
                                    <FontIcon Glyph="&#xE71B;" FontSize="14" Foreground="{ThemeResource MutedBrush}" VerticalAlignment="Top" Margin="0,2,0,0" />
                                    <TextBlock Text="可同时选择多台扬声器。&#x0a;需要密码时会分别提示输入。" FontSize="12" Foreground="{ThemeResource MutedBrush}" LineHeight="18" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>

                    <Grid Grid.Column="1" RowSpacing="18">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Border Style="{StaticResource CardStyle}" Padding="20,17">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="42" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Width="42" Height="42" CornerRadius="12" Background="{ThemeResource BrandSoftBrush}" VerticalAlignment="Center">
                                    <FontIcon Glyph="&#xE7F4;" FontSize="20" Foreground="{ThemeResource BrandBrush}" />
                                </Border>
                                <StackPanel Grid.Column="1" Spacing="7">
                                    <TextBlock Text="声音来源" FontSize="12" Foreground="{ThemeResource MutedBrush}" />
                                    <ComboBox x:Name="SourcePicker" PlaceholderText="正在读取 Windows 音频输出…" HorizontalAlignment="Stretch" SelectionChanged="OnSourceChanged" AutomationProperties.Name="声音来源，Windows 播放设备" MinWidth="160" ToolTipService.ToolTip="选择正在播放音乐的 Windows 输出设备。传输时切换会重新连接扬声器。" />
                                    <Grid ColumnSpacing="12" Margin="0,3,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Name="CaptureStatusText" Text="连接后会显示采集状态。" FontSize="11" Foreground="{ThemeResource MutedBrush}" TextWrapping="Wrap" VerticalAlignment="Center" AutomationProperties.LiveSetting="Polite" />
                                        <Button x:Name="TestToneButton" Grid.Column="1" Click="OnTestTone" IsEnabled="False" Style="{StaticResource SubtleButtonStyle}" ToolTipService.ToolTip="向已连接的扬声器播放 3 秒测试音，用来区分声源与连接问题。">
                                            <StackPanel Orientation="Horizontal" Spacing="7">
                                                <FontIcon Glyph="&#xE767;" FontSize="12" />
                                                <TextBlock x:Name="TestToneLabel" Text="试播 3 秒" FontSize="12" />
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Grid.Row="1" Style="{StaticResource CardStyle}" Padding="24,22,24,18">
                            <Grid RowSpacing="18">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="116" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <Grid ColumnSpacing="18">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="58" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Spacing="7" VerticalAlignment="Center">
                                        <TextBlock x:Name="SessionEyebrow" Text="你的声音，即将出发" FontSize="12" Foreground="{ThemeResource MutedBrush}" />
                                        <TextBlock x:Name="TargetName" Text="选择一台扬声器" FontSize="25" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        <TextBlock x:Name="StatusDescription" Text="在左侧选择设备，然后开始连接。" FontSize="12" Foreground="{ThemeResource MutedBrush}" TextWrapping="Wrap" MaxLines="2" />
                                    </StackPanel>
                                    <Grid Grid.Column="1" Width="54" Height="66" AutomationProperties.AccessibilityView="Raw">
                                        <Rectangle Width="48" Height="59" VerticalAlignment="Bottom" RadiusX="19" RadiusY="19" Fill="{ThemeResource SpeakerBodyBrush}" />
                                        <Ellipse Width="46" Height="14" VerticalAlignment="Top" Margin="0,5,0,0" Fill="{ThemeResource SpeakerTopBrush}" />
                                        <Ellipse Width="29" Height="6" VerticalAlignment="Top" Margin="0,9,0,0" Fill="{ThemeResource BrandBrush}" Opacity="0.7" />
                                        <Path Data="M 12,31 L 42,31 M 12,37 L 42,37 M 12,43 L 42,43 M 14,49 L 40,49" Stroke="{ThemeResource MutedBrush}" StrokeThickness="0.6" Opacity="0.35" />
                                    </Grid>
                                </Grid>

                                <Border Grid.Row="1" CornerRadius="14" Background="{ThemeResource InsetBrush}" BorderBrush="{ThemeResource HairlineBrush}" BorderThickness="1" Padding="12,8">
                                    <Grid>
                                        <Canvas x:Name="WaveformCanvas" SizeChanged="OnWaveformSizeChanged" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" AutomationProperties.AccessibilityView="Raw">
                                            <Line x:Name="WaveformBaseline" X1="0" Y1="48" X2="400" Y2="48" Stroke="{ThemeResource HairlineBrush}" StrokeThickness="1" />
                                            <Polyline x:Name="WaveformLine" Stroke="{ThemeResource AudioBrush}" StrokeThickness="1.8" StrokeLineJoin="Round" />
                                        </Canvas>
                                        <TextBlock x:Name="WaveformHint" Text="连接后显示实时音频" FontSize="12" Foreground="{ThemeResource MutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Grid>
                                </Border>

                                <Grid Grid.Row="2" ColumnSpacing="10" RowSpacing="6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="14" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="45" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="L" FontSize="10" FontWeight="SemiBold" Foreground="{ThemeResource MutedBrush}" />
                                    <ProgressBar x:Name="LeftMeter" Grid.Column="1" Minimum="0" Maximum="1" Value="0" Foreground="{ThemeResource AudioBrush}" Background="{ThemeResource InsetBrush}" Height="4" VerticalAlignment="Center" AutomationProperties.Name="左声道电平" />
                                    <TextBlock x:Name="LeftDb" Grid.Column="2" Text="−∞ dB" FontSize="10" Foreground="{ThemeResource MutedBrush}" HorizontalAlignment="Right" />
                                    <TextBlock Grid.Row="1" Text="R" FontSize="10" FontWeight="SemiBold" Foreground="{ThemeResource MutedBrush}" />
                                    <ProgressBar x:Name="RightMeter" Grid.Row="1" Grid.Column="1" Minimum="0" Maximum="1" Value="0" Foreground="{ThemeResource AudioBrush}" Background="{ThemeResource InsetBrush}" Height="4" VerticalAlignment="Center" AutomationProperties.Name="右声道电平" />
                                    <TextBlock x:Name="RightDb" Grid.Row="1" Grid.Column="2" Text="−∞ dB" FontSize="10" Foreground="{ThemeResource MutedBrush}" HorizontalAlignment="Right" />
                                </Grid>

                                <Grid Grid.Row="3" ColumnSpacing="18" BorderBrush="{ThemeResource HairlineBrush}" BorderThickness="0,1,0,0" Padding="0,13,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="采样率" Style="{StaticResource QuietLabelStyle}" />
                                        <TextBlock x:Name="SampleRateText" Text="—" FontSize="13" FontWeight="SemiBold" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Spacing="4">
                                        <TextBlock Text="已传输" Style="{StaticResource QuietLabelStyle}" />
                                        <TextBlock x:Name="ElapsedText" Text="—" FontSize="13" FontWeight="SemiBold" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Spacing="4">
                                        <TextBlock Text="发送数据包" Style="{StaticResource QuietLabelStyle}" />
                                        <TextBlock x:Name="PacketsText" Text="—" FontSize="13" FontWeight="SemiBold" />
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>

                <Border Grid.Row="3" Style="{StaticResource CardStyle}" Padding="20,16">
                    <Grid ColumnSpacing="24">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                            <Button x:Name="ConnectButton" Style="{StaticResource AccentButtonStyle}" MinWidth="152" Height="44" CornerRadius="12" IsEnabled="False" Click="OnConnect">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <ProgressRing x:Name="ConnectSpinner" IsActive="False" Width="16" Height="16" Visibility="Collapsed" Foreground="White" />
                                    <FontIcon x:Name="ConnectGlyph" Glyph="&#xE768;" FontSize="14" />
                                    <TextBlock x:Name="ConnectLabel" Text="开始连接" FontSize="14" FontWeight="SemiBold" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="CancelAuthButton" Content="取消" Click="OnCancelAuth" Visibility="Collapsed" Style="{StaticResource SubtleButtonStyle}" />
                        </StackPanel>

                        <Grid Grid.Column="1" VerticalAlignment="Center" ColumnSpacing="10" MinWidth="140">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="34" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xE767;" FontSize="17" Foreground="{ThemeResource MutedBrush}" />
                            <Slider x:Name="VolumeSlider" Grid.Column="1" Minimum="0" Maximum="100" Value="75" StepFrequency="1" TickFrequency="10" SmallChange="1" LargeChange="10" ValueChanged="OnVolumeChanged" AutomationProperties.Name="扬声器音量" IsEnabled="False" />
                            <TextBlock x:Name="VolumeLabel" Grid.Column="2" Text="75%" FontSize="12" Foreground="{ThemeResource MutedBrush}" VerticalAlignment="Center" HorizontalAlignment="Right" />
                        </Grid>

                        <ToggleSwitch x:Name="LocalMuteToggle" Grid.Column="2" Header="电脑静音" OnContent="已请求" OffContent="关闭" IsEnabled="False" Toggled="OnMuteLocalChanged" ToolTipService.ToolTip="静音所选 Windows 输出设备；同一输出上的所有应用都会受影响。断开后由音频引擎恢复。" />
                    </Grid>
                </Border>

                <Grid Grid.Row="4" Margin="3,-8,3,0" ColumnSpacing="20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="FooterMessage" Text="无需新装虚拟声卡 · 声源需是 Windows 中已存在的播放设备" FontSize="11" Foreground="{ThemeResource MutedBrush}" TextWrapping="Wrap" />
                    <TextBlock Grid.Column="1" Text="关掉窗口，音乐继续。" FontSize="11" Foreground="{ThemeResource MutedBrush}" VerticalAlignment="Top" />
                </Grid>
            </Grid>
        </ScrollViewer>

        <ScrollViewer x:Name="SettingsScrollViewer" Grid.Row="1" Visibility="Collapsed" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" Padding="0,0,0,12">
            <StackPanel x:Name="SettingsContent" MaxWidth="1000" Margin="30,20,30,24" Spacing="20">
                <Grid ColumnSpacing="16" Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button x:Name="SettingsBackButton" Width="40" Height="40" Click="OnCloseSettings" Style="{StaticResource SubtleButtonStyle}" VerticalAlignment="Center" AutomationProperties.Name="返回声音投放" ToolTipService.ToolTip="返回声音投放">
                        <FontIcon Glyph="&#xE72B;" FontSize="18" />
                    </Button>
                    <StackPanel Grid.Column="1" Spacing="6">
                        <TextBlock Text="随心设置" FontSize="30" FontWeight="SemiBold" />
                        <TextBlock Text="让 Airloom 更贴合你的房间与习惯。" FontSize="14" Foreground="{ThemeResource MutedBrush}" />
                    </StackPanel>
                </Grid>

                <InfoBar x:Name="SettingsErrorBanner" IsOpen="False" IsClosable="False" Severity="Error" Title="操作需要处理" />

                <Border Style="{StaticResource CardStyle}" Padding="24">
                    <StackPanel Spacing="20">
                        <StackPanel Spacing="5">
                            <TextBlock Text="外观与启动" FontSize="18" FontWeight="SemiBold" />
                            <TextBlock Text="主题、动效和后台体验。" FontSize="12" Foreground="{ThemeResource MutedBrush}" />
                        </StackPanel>
                        <Grid ColumnSpacing="24">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <ComboBox x:Name="ThemePicker" Header="应用主题" HorizontalAlignment="Stretch" SelectionChanged="OnThemeChanged" AutomationProperties.Name="应用主题">
                                <ComboBoxItem Content="跟随 Windows" />
                                <ComboBoxItem Content="浅色" />
                                <ComboBoxItem Content="深色" />
                            </ComboBox>
                            <ToggleSwitch x:Name="VisualizerToggle" Grid.Column="1" Header="动态波形" OnContent="实时音频" OffContent="只显示电平" Toggled="OnVisualizerChanged" />
                            <ToggleSwitch x:Name="StartupToggle" Grid.Column="2" Header="登录 Windows 后启动" OnContent="在托盘中启动" OffContent="手动打开" Toggled="OnStartupChanged" />
                        </Grid>
                        <TextBlock Text="转场与波形动效会遵循 Windows 的动画设置。" FontSize="11" Foreground="{ThemeResource MutedBrush}" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardStyle}" Padding="24">
                    <StackPanel Spacing="18">
                        <Grid ColumnSpacing="18">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="48" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Width="48" Height="48" CornerRadius="14" Background="{ThemeResource BrandSoftBrush}" VerticalAlignment="Top">
                                <FontIcon Glyph="&#xE895;" FontSize="22" Foreground="{ThemeResource BrandBrush}" />
                            </Border>
                            <StackPanel Grid.Column="1" Spacing="5">
                                <TextBlock Text="保持新鲜" FontSize="18" FontWeight="SemiBold" />
                                <TextBlock x:Name="CurrentVersionText" Text="Airloom" FontSize="12" Foreground="{ThemeResource MutedBrush}" />
                                <TextBlock x:Name="UpdateStatusText" Text="检查是否有可用的新版本。" FontSize="13" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
                            </StackPanel>
                        </Grid>
                        <ProgressBar x:Name="UpdateProgress" Minimum="0" Maximum="100" Visibility="Collapsed" Foreground="{ThemeResource BrandBrush}" AutomationProperties.Name="更新下载进度" />
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Button x:Name="CheckUpdatesButton" Content="检查更新" Click="OnCheckUpdates" />
                            <Button x:Name="InstallUpdateButton" Content="下载并安装" Click="OnInstallUpdate" Style="{StaticResource AccentButtonStyle}" Visibility="Collapsed" />
                            <Button x:Name="CancelUpdateButton" Content="取消" Click="OnCancelUpdate" Visibility="Collapsed" />
                            <HyperlinkButton Content="版本说明" NavigateUri="https://github.com/chummumm/airloom/releases/latest" />
                        </StackPanel>
                        <TextBlock Text="安装前会结束当前传输并退出。更新完成后自动重新打开，下载的安装包与临时文件会自动清理。" FontSize="11" Foreground="{ThemeResource MutedBrush}" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardStyle}" Padding="24">
                    <StackPanel Spacing="18">
                        <Grid ColumnSpacing="20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="5">
                                <TextBlock Text="设备显示" FontSize="18" FontWeight="SemiBold" />
                                <TextBlock Text="隐藏不常用的设备，让首页只留下你想听的房间。" FontSize="12" Foreground="{ThemeResource MutedBrush}" TextWrapping="Wrap" />
                            </StackPanel>
                            <Button Grid.Column="1" Content="重新发现" Click="OnRefresh" Style="{StaticResource SubtleButtonStyle}" VerticalAlignment="Center" />
                        </Grid>
                        <TextBlock x:Name="VisibilitySummary" FontSize="12" Foreground="{ThemeResource MutedBrush}" />
                        <StackPanel x:Name="DeviceVisibilityList" Spacing="8" />
                        <TextBlock x:Name="VisibilityEmptyText" Text="尚未发现设备。连接同一网络后，点击“重新发现”。" FontSize="12" Foreground="{ThemeResource MutedBrush}" TextWrapping="Wrap" />
                        <TextBlock Text="隐藏正在使用的设备会停止向它传输。可在这里随时恢复，隐藏设置会保存在这台电脑上。" FontSize="11" Foreground="{ThemeResource MutedBrush}" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardStyle}" Padding="24,20">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="5" VerticalAlignment="Center">
                            <TextBlock Text="Airloom · 开源音频投放" FontSize="14" FontWeight="SemiBold" />
                            <TextBlock Text="原生 Windows 界面，让声音自由流动。" FontSize="12" Foreground="{ThemeResource MutedBrush}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10">
                            <Button x:Name="ForgetButton" IsEnabled="False" Click="OnForgetCredentials">
                                <TextBlock x:Name="ForgetLabel" Text="忘记设备凭据" MaxWidth="210" TextTrimming="CharacterEllipsis" />
                            </Button>
                            <Button Content="退出 Airloom" Click="OnExitClick" />
                        </StackPanel>
                    </Grid>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
