<Window
    x:Class="Airloom.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Airloom">
    <Grid x:Name="LayoutRoot" Background="{ThemeResource AppCanvasBrush}"
          Loaded="OnLoaded" ActualThemeChanged="OnActualThemeChanged" AutomationProperties.AutomationId="LayoutRoot">
        <Grid.RowDefinitions>
            <RowDefinition Height="44" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="WorkspaceWidth">
                <VisualState x:Name="WideWorkspace">
                    <VisualState.StateTriggers><AdaptiveTrigger MinWindowWidth="1280" /></VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="TransportColumn.Width" Value="332" />
                        <Setter Target="SessionGrid.ColumnSpacing" Value="14" />
                        <Setter Target="SessionGrid.RowSpacing" Value="0" />
                        <Setter Target="SignalPanel.(Grid.ColumnSpan)" Value="1" />
                        <Setter Target="TransportPanel.(Grid.Row)" Value="0" />
                        <Setter Target="TransportPanel.(Grid.Column)" Value="1" />
                        <Setter Target="TransportPanel.(Grid.ColumnSpan)" Value="1" />
                        <Setter Target="TransportActions.(Grid.Row)" Value="1" />
                        <Setter Target="TransportActions.(Grid.Column)" Value="0" />
                        <Setter Target="TransportActions.(Grid.ColumnSpan)" Value="3" />
                        <Setter Target="TransportActions.HorizontalAlignment" Value="Left" />
                        <Setter Target="LocalMuteSection.(Grid.Row)" Value="2" />
                        <Setter Target="LocalMuteSection.(Grid.Column)" Value="0" />
                        <Setter Target="LocalMuteSection.(Grid.ColumnSpan)" Value="3" />
                        <Setter Target="LocalMuteSection.HorizontalAlignment" Value="Left" />
                        <Setter Target="SignalWaveformRow.Height" Value="100" />
                        <Setter Target="TransportActionColumn.Width" Value="0" />
                        <Setter Target="TransportMuteColumn.Width" Value="0" />
                        <Setter Target="VolumeSection.(Grid.ColumnSpan)" Value="3" />
                        <Setter Target="TransportLayout.ColumnSpacing" Value="0" />
                        <Setter Target="TransportLayout.RowSpacing" Value="22" />
                        <Setter Target="VolumeScope.Visibility" Value="Visible" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="CompactWorkspace">
                    <VisualState.StateTriggers><AdaptiveTrigger MinWindowWidth="0" /></VisualState.StateTriggers>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <Grid x:Name="TitleDragRegion" Background="Transparent" Padding="22,0,160,0">
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <Grid Width="20" Height="22" AutomationProperties.AccessibilityView="Raw">
                    <Rectangle Width="3" Height="10" RadiusX="1.5" RadiusY="1.5" Fill="{ThemeResource InkBrush}" HorizontalAlignment="Left" />
                    <Rectangle Width="3" Height="21" RadiusX="1.5" RadiusY="1.5" Fill="{ThemeResource InkBrush}" />
                    <Rectangle Width="3" Height="15" RadiusX="1.5" RadiusY="1.5" Fill="{ThemeResource InkBrush}" HorizontalAlignment="Right" />
                </Grid>
                <TextBlock Text="Airloom" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
                <TextBlock Text="Windows 音频投放" FontSize="12" Foreground="{ThemeResource MutedBrush}" VerticalAlignment="Center" Margin="8,0,0,0" />
            </StackPanel>
        </Grid>

        <Grid x:Name="HomeView" Grid.Row="1" AutomationProperties.AutomationId="HomeView" AutomationProperties.Name="声音投放工作区" AutomationProperties.AccessibilityView="Content">
            <Grid.ColumnDefinitions><ColumnDefinition Width="248" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <!-- Fixed rail + 1* workspace. The workspace scroll viewport owns width;
                 changing text, values and row state cannot recenter the page. -->
            <Border x:Name="DeviceRail" BorderBrush="{ThemeResource HairlineBrush}" BorderThickness="0,0,1,0" Padding="14,14,14,18"
                    AutomationProperties.AutomationId="DeviceRail" AutomationProperties.Name="扬声器列表" AutomationProperties.AccessibilityView="Content">
                <Grid RowSpacing="14">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <Grid Margin="8,0,2,0" ColumnSpacing="8">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="36" /></Grid.ColumnDefinitions>
                        <StackPanel Spacing="5">
                            <TextBlock Text="扬声器" FontSize="16" FontWeight="SemiBold" />
                            <TextBlock x:Name="DeviceCount" Text="在同一网络中发现" FontSize="12" Foreground="{ThemeResource MutedBrush}" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <Button x:Name="RefreshButton" Grid.Column="1" Style="{StaticResource SubtleButtonStyle}" Width="36" Height="36" Padding="0" Click="OnRefresh" AutomationProperties.Name="重新发现扬声器" AutomationProperties.AutomationId="RefreshButton" ToolTipService.ToolTip="重新发现扬声器">
                            <FontIcon Glyph="&#xE72C;" FontSize="16" />
                        </Button>
                    </Grid>
                    <Grid Grid.Row="1">
                        <ScrollViewer HorizontalScrollBarVisibility="Disabled" HorizontalScrollMode="Disabled" VerticalScrollBarVisibility="Visible" HorizontalContentAlignment="Stretch">
                            <StackPanel x:Name="DeviceCards" Spacing="4" Margin="0,0,2,0" />
                        </ScrollViewer>
                        <StackPanel x:Name="DevicesEmptyState" VerticalAlignment="Top" Spacing="10" Margin="8,22,12,0">
                            <TextBlock x:Name="EmptyDeviceTitle" Text="尚未发现扬声器" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" />
                            <TextBlock x:Name="EmptyDeviceDescription" Text="将电脑和 HomePod 接入同一网络，然后重新发现。" FontSize="12" Foreground="{ThemeResource MutedBrush}" TextWrapping="Wrap" LineHeight="20" />
                            <ProgressRing x:Name="DiscoveryRing" Width="18" Height="18" IsActive="False" Visibility="Collapsed" HorizontalAlignment="Left" Foreground="{ThemeResource InkBrush}" />
                        </StackPanel>
                    </Grid>
                    <StackPanel Grid.Row="2" Spacing="10" Margin="8,0,8,0">
                        <TextBlock Text="可同时选择多台扬声器。需要密码的设备会分别验证。" FontSize="12" Foreground="{ThemeResource MutedBrush}" TextWrapping="Wrap" LineHeight="20" />
                        <Button Content="管理设备显示" Click="OnOpenSettings" Style="{StaticResource SubtleButtonStyle}" Padding="0,7" HorizontalAlignment="Left" />
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Column="1">
                <Grid.RowDefinitions><RowDefinition Height="64" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                <Grid BorderBrush="{ThemeResource HairlineBrush}" BorderThickness="0,0,0,1" Padding="22,0" ColumnSpacing="14">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="170" /><ColumnDefinition Width="76" /></Grid.ColumnDefinitions>
                    <TextBlock Text="声音投放" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" AutomationProperties.HeadingLevel="Level1" />
                    <Grid Grid.Column="1" ColumnSpacing="8" VerticalAlignment="Center">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="6" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Ellipse x:Name="StatusDot" Width="6" Height="6" Fill="{ThemeResource MutedBrush}" />
                        <TextBlock x:Name="StatusBadge" Grid.Column="1" Text="等待连接" FontSize="12" TextTrimming="CharacterEllipsis" AutomationProperties.LiveSetting="Polite" />
                    </Grid>
                    <Button x:Name="SettingsButton" Grid.Column="2" Style="{StaticResource SubtleButtonStyle}" Height="36" Padding="8,0" Click="OnOpenSettings" AutomationProperties.Name="设置" AutomationProperties.AutomationId="SettingsButton" ToolTipService.ToolTip="设置与更新">
                        <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE713;" FontSize="16" /><TextBlock Text="设置" FontSize="13" /></StackPanel>
                    </Button>
                </Grid>
                <ScrollViewer x:Name="HomeScrollViewer" Grid.Row="1" HorizontalScrollBarVisibility="Disabled" HorizontalScrollMode="Disabled" VerticalScrollBarVisibility="Visible" HorizontalContentAlignment="Stretch" ZoomMode="Disabled" AutomationProperties.AutomationId="HomeScrollViewer">
                    <Grid x:Name="PageContent" Width="{Binding ViewportWidth, ElementName=HomeScrollViewer}" Padding="22,14,22,20" RowSpacing="14"
                          AutomationProperties.AutomationId="PageContent" AutomationProperties.Name="投放控制" AutomationProperties.AccessibilityView="Content">
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <InfoBar x:Name="ErrorBanner" IsOpen="False" IsClosable="False" Severity="Error" Title="连接需要处理">
                            <InfoBar.ActionButton><Button x:Name="RetryButton" Content="重试" Click="OnRetry" /></InfoBar.ActionButton>
                        </InfoBar>

                        <Grid Grid.Row="1" RowSpacing="8" AutomationProperties.AutomationId="SourcePanel">
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="36" /><RowDefinition Height="Auto" MinHeight="40" /></Grid.RowDefinitions>
                            <TextBlock Text="声音来源" FontSize="12" Foreground="{ThemeResource MutedBrush}" />
                            <ComboBox x:Name="SourcePicker" Grid.Row="1" PlaceholderText="正在读取 Windows 音频输出…" HorizontalAlignment="Stretch" Height="36" SelectionChanged="OnSourceChanged" AutomationProperties.Name="声音来源，Windows 播放设备" AutomationProperties.AutomationId="SourcePicker" ToolTipService.ToolTip="选择正在播放声音的 Windows 输出设备。传输时切换会重新连接扬声器。" />
                            <Grid Grid.Row="2" ColumnSpacing="14">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="116" /></Grid.ColumnDefinitions>
                                <TextBlock x:Name="CaptureStatusText" Text="连接后显示实际声音采集状态。" FontSize="12" Foreground="{ThemeResource MutedBrush}" TextWrapping="Wrap" MaxLines="2" LineHeight="18" VerticalAlignment="Center" AutomationProperties.AutomationId="CaptureStatusText" />
                                <Button x:Name="TestToneButton" Grid.Column="1" Click="OnTestTone" Style="{StaticResource SubtleButtonStyle}" IsEnabled="False" Padding="8,0" AutomationProperties.Name="播放三秒测试音" AutomationProperties.AutomationId="TestToneButton">
                                    <StackPanel Orientation="Horizontal" Spacing="7"><FontIcon Glyph="&#xE767;" FontSize="14" /><TextBlock x:Name="TestToneLabel" Text="试播 3 秒" FontSize="12" /></StackPanel>
                                </Button>
                                <Button x:Name="SourceRetryButton" Grid.Column="1" Content="重新扫描" Click="OnRefresh" Style="{StaticResource SubtleButtonStyle}" Padding="8,0" VerticalAlignment="Center" Visibility="Collapsed" AutomationProperties.Name="重新扫描 Windows 音频输出" AutomationProperties.AutomationId="SourceRetryButton" />
                            </Grid>
                        </Grid>

                        <Grid x:Name="SessionGrid" Grid.Row="2" RowSpacing="14">
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition x:Name="TransportColumn" Width="0" /></Grid.ColumnDefinitions>
                            <Border x:Name="SignalPanel" Grid.ColumnSpan="2" Style="{StaticResource CardStyle}" Padding="22,18"
                                    AutomationProperties.AutomationId="SignalPanel" AutomationProperties.Name="实际音频信号" AutomationProperties.AccessibilityView="Content">
                                <Grid RowSpacing="10">
                                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition x:Name="SignalWaveformRow" Height="60" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                    <StackPanel Spacing="4">
                                        <TextBlock x:Name="SessionEyebrow" Text="尚未连接" FontSize="12" Foreground="{ThemeResource MutedBrush}" />
                                        <TextBlock x:Name="TargetName" Text="选择扬声器" FontSize="22" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" AutomationProperties.AutomationId="TargetName" />
                                        <TextBlock x:Name="StatusDescription" Text="在左侧选择设备，然后开始连接。" FontSize="12" Foreground="{ThemeResource MutedBrush}" TextTrimming="CharacterEllipsis" MaxLines="1" LineHeight="18" Height="18" />
                                    </StackPanel>
                                    <Grid Grid.Row="1">
                                        <Canvas x:Name="WaveformCanvas" SizeChanged="OnWaveformSizeChanged" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" AutomationProperties.AccessibilityView="Raw">
                                            <Line x:Name="WaveformBaseline" X1="0" Y1="40" X2="400" Y2="40" Stroke="{ThemeResource HairlineBrush}" StrokeThickness="1" />
                                            <Polyline x:Name="WaveformLine" Stroke="{ThemeResource AudioBrush}" StrokeThickness="1.8" StrokeLineJoin="Round" />
                                        </Canvas>
                                        <TextBlock x:Name="WaveformHint" Text="连接后显示实际音频波形" FontSize="12" Foreground="{ThemeResource MutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" Margin="8,0" />
                                    </Grid>
                                    <Grid Grid.Row="2" ColumnSpacing="10" RowSpacing="4">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="16" /><ColumnDefinition Width="*" /><ColumnDefinition Width="60" /></Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                        <TextBlock Text="L" FontSize="12" Foreground="{ThemeResource MutedBrush}" />
                                        <ProgressBar x:Name="LeftMeter" Grid.Column="1" Minimum="0" Maximum="1" Value="0" Height="4" VerticalAlignment="Center" Foreground="{ThemeResource AudioBrush}" Background="{ThemeResource InsetBrush}" AutomationProperties.Name="左声道电平" />
                                        <TextBlock x:Name="LeftDb" Grid.Column="2" Text="−∞ dB" FontSize="12" Foreground="{ThemeResource MutedBrush}" TextAlignment="Right" Typography.NumeralAlignment="Tabular" />
                                        <TextBlock Grid.Row="1" Text="R" FontSize="12" Foreground="{ThemeResource MutedBrush}" />
                                        <ProgressBar x:Name="RightMeter" Grid.Row="1" Grid.Column="1" Minimum="0" Maximum="1" Value="0" Height="4" VerticalAlignment="Center" Foreground="{ThemeResource AudioBrush}" Background="{ThemeResource InsetBrush}" AutomationProperties.Name="右声道电平" />
                                        <TextBlock x:Name="RightDb" Grid.Row="1" Grid.Column="2" Text="−∞ dB" FontSize="12" Foreground="{ThemeResource MutedBrush}" TextAlignment="Right" Typography.NumeralAlignment="Tabular" />
                                    </Grid>
                                    <Grid Grid.Row="3" ColumnSpacing="14" Margin="0,4,0,0">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><TextBlock Text="采样率" Style="{StaticResource QuietLabelStyle}" /><TextBlock x:Name="SampleRateText" Grid.Column="1" Text="—" FontSize="12" Typography.NumeralAlignment="Tabular" TextAlignment="Right" /></Grid>
                                        <Grid Grid.Column="1" ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><TextBlock Text="传输" Style="{StaticResource QuietLabelStyle}" /><TextBlock x:Name="ElapsedText" Grid.Column="1" Text="—" FontSize="12" Typography.NumeralAlignment="Tabular" TextAlignment="Right" /></Grid>
                                        <Grid Grid.Column="2" ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><TextBlock Text="数据包" Style="{StaticResource QuietLabelStyle}" /><TextBlock x:Name="PacketsText" Grid.Column="1" Text="—" FontSize="12" Typography.NumeralAlignment="Tabular" TextAlignment="Right" TextTrimming="CharacterEllipsis" /></Grid>
                                    </Grid>
                                </Grid>
                            </Border>

                            <Border x:Name="TransportPanel" Grid.Row="1" Grid.ColumnSpan="2" Style="{StaticResource CardStyle}" Padding="22,18" VerticalAlignment="Top"
                                    AutomationProperties.AutomationId="TransportPanel" AutomationProperties.Name="音量与连接控制" AutomationProperties.AccessibilityView="Content">
                                <Grid x:Name="TransportLayout" ColumnSpacing="16" RowSpacing="0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition x:Name="TransportActionColumn" Width="146" /><ColumnDefinition x:Name="TransportMuteColumn" Width="112" /></Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                    <Grid x:Name="VolumeSection" RowSpacing="3" VerticalAlignment="Center">
                                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="32" /></Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="52" /></Grid.ColumnDefinitions>
                                        <TextBlock Text="扬声器音量" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
                                        <TextBlock x:Name="VolumeLabel" Grid.Column="1" Text="75%" FontSize="14" FontWeight="SemiBold" Width="52" TextAlignment="Right" Typography.NumeralAlignment="Tabular" AutomationProperties.AutomationId="VolumeValue" />
                                        <!-- The native thumb draws 2 px beyond its layout bounds at
                                             either endpoint. Keep that outset inside a stable slot. -->
                                        <Grid x:Name="VolumeSliderHost" Grid.Row="1" Grid.ColumnSpan="2" Padding="2,0" Background="Transparent" AutomationProperties.AutomationId="VolumeSliderHost" AutomationProperties.Name="扬声器音量轨道" AutomationProperties.AccessibilityView="Content">
                                            <Slider x:Name="VolumeSlider" Minimum="0" Maximum="100" Value="75" StepFrequency="1" SmallChange="1" LargeChange="10" ValueChanged="OnVolumeChanged" AutomationProperties.Name="扬声器音量" AutomationProperties.AutomationId="VolumeSlider" IsEnabled="False" Foreground="{ThemeResource InkBrush}">
                                                <Slider.Resources>
                                                    <ResourceDictionary>
                                                        <ResourceDictionary.ThemeDictionaries>
                                                            <ResourceDictionary x:Key="Default">
                                                                <SolidColorBrush x:Key="SliderThumbBackground" Color="#F7F7F7" />
                                                                <SolidColorBrush x:Key="SliderThumbBackgroundPointerOver" Color="#DDDDDD" />
                                                                <SolidColorBrush x:Key="SliderThumbBackgroundPressed" Color="#C7C7C7" />
                                                                <SolidColorBrush x:Key="SliderThumbBackgroundDisabled" Color="#777777" />
                                                                <SolidColorBrush x:Key="SliderTrackValueFill" Color="#F7F7F7" />
                                                                <SolidColorBrush x:Key="SliderTrackValueFillPointerOver" Color="#DDDDDD" />
                                                                <SolidColorBrush x:Key="SliderTrackValueFillPressed" Color="#C7C7C7" />
                                                                <SolidColorBrush x:Key="SliderTrackValueFillDisabled" Color="#777777" />
                                                            </ResourceDictionary>
                                                            <ResourceDictionary x:Key="Light">
                                                                <SolidColorBrush x:Key="SliderThumbBackground" Color="#202020" />
                                                                <SolidColorBrush x:Key="SliderThumbBackgroundPointerOver" Color="#393939" />
                                                                <SolidColorBrush x:Key="SliderThumbBackgroundPressed" Color="#505050" />
                                                                <SolidColorBrush x:Key="SliderThumbBackgroundDisabled" Color="#8A8A8A" />
                                                                <SolidColorBrush x:Key="SliderTrackValueFill" Color="#202020" />
                                                                <SolidColorBrush x:Key="SliderTrackValueFillPointerOver" Color="#393939" />
                                                                <SolidColorBrush x:Key="SliderTrackValueFillPressed" Color="#505050" />
                                                                <SolidColorBrush x:Key="SliderTrackValueFillDisabled" Color="#8A8A8A" />
                                                            </ResourceDictionary>
                                                            <ResourceDictionary x:Key="HighContrast">
                                                                <SolidColorBrush x:Key="SliderThumbBackground" Color="{ThemeResource SystemColorHighlightColor}" />
                                                                <SolidColorBrush x:Key="SliderThumbBackgroundPointerOver" Color="{ThemeResource SystemColorHighlightColor}" />
                                                                <SolidColorBrush x:Key="SliderThumbBackgroundPressed" Color="{ThemeResource SystemColorHotlightColor}" />
                                                                <SolidColorBrush x:Key="SliderThumbBackgroundDisabled" Color="{ThemeResource SystemColorGrayTextColor}" />
                                                                <SolidColorBrush x:Key="SliderTrackValueFill" Color="{ThemeResource SystemColorHighlightColor}" />
                                                                <SolidColorBrush x:Key="SliderTrackValueFillPointerOver" Color="{ThemeResource SystemColorHighlightColor}" />
                                                                <SolidColorBrush x:Key="SliderTrackValueFillPressed" Color="{ThemeResource SystemColorHotlightColor}" />
                                                                <SolidColorBrush x:Key="SliderTrackValueFillDisabled" Color="{ThemeResource SystemColorGrayTextColor}" />
                                                            </ResourceDictionary>
                                                        </ResourceDictionary.ThemeDictionaries>
                                                    </ResourceDictionary>
                                                </Slider.Resources>
                                            </Slider>
                                        </Grid>
                                    </Grid>
                                    <StackPanel x:Name="TransportActions" Grid.Column="1" Spacing="8" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <Button x:Name="ConnectButton" Style="{StaticResource PrimaryButtonStyle}" Width="146" Height="36" IsEnabled="False" Click="OnConnect" AutomationProperties.AutomationId="ConnectButton">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <ProgressRing x:Name="ConnectSpinner" Width="14" Height="14" IsActive="False" Visibility="Collapsed" Foreground="{ThemeResource PrimaryActionTextBrush}" />
                                                <FontIcon x:Name="ConnectGlyph" Glyph="&#xE768;" FontSize="13" Foreground="{ThemeResource MutedBrush}" />
                                                <TextBlock x:Name="ConnectLabel" Text="开始连接" FontSize="13" FontWeight="SemiBold" Foreground="{ThemeResource MutedBrush}" />
                                            </StackPanel>
                                        </Button>
                                        <Button x:Name="CancelAuthButton" Content="取消此设备" Click="OnCancelAuth" Visibility="Collapsed" Style="{StaticResource SubtleButtonStyle}" HorizontalAlignment="Stretch" />
                                    </StackPanel>
                                    <StackPanel x:Name="LocalMuteSection" Grid.Column="2" Spacing="3" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <TextBlock Text="静音电脑输出" FontSize="13" />
                                        <ToggleSwitch x:Name="LocalMuteToggle" OnContent="" OffContent="" MinWidth="0" Width="52" IsEnabled="False" Toggled="OnMuteLocalChanged" AutomationProperties.Name="静音电脑输出" AutomationProperties.AutomationId="LocalMuteToggle" ToolTipService.ToolTip="静音所选 Windows 输出设备；同一输出上的所有应用都会受影响。断开后恢复原状态。若采集无声，请先关闭此选项。" />
                                    </StackPanel>
                                    <TextBlock x:Name="VolumeScope" Grid.Row="3" Grid.ColumnSpan="3" Text="音量作用于所有已选扬声器。&#x0a;新增设备会沿用当前音量。" FontSize="12" Foreground="{ThemeResource MutedBrush}" TextWrapping="Wrap" LineHeight="20" Visibility="Collapsed" />
                                </Grid>
                            </Border>
                        </Grid>
                        <TextBlock x:Name="FooterMessage" Grid.Row="3" Text="选择扬声器后开始连接。关闭窗口可继续在托盘中运行。" FontSize="12" Foreground="{ThemeResource MutedBrush}" TextWrapping="Wrap" MaxLines="2" LineHeight="18" MinHeight="36" />
                    </Grid>
                </ScrollViewer>
            </Grid>
        </Grid>

        <Grid x:Name="SettingsView" Grid.Row="1" Visibility="Collapsed" AutomationProperties.AutomationId="SettingsView">
            <Grid.RowDefinitions><RowDefinition Height="64" /><RowDefinition Height="*" /></Grid.RowDefinitions>
            <Grid Padding="22,0" BorderBrush="{ThemeResource HairlineBrush}" BorderThickness="0,0,0,1" ColumnSpacing="14">
                <Grid.ColumnDefinitions><ColumnDefinition Width="36" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <Button x:Name="SettingsBackButton" Width="36" Height="36" Padding="0" Click="OnCloseSettings" Style="{StaticResource SubtleButtonStyle}" VerticalAlignment="Center" AutomationProperties.Name="返回声音投放" AutomationProperties.AutomationId="SettingsBackButton" ToolTipService.ToolTip="返回声音投放"><FontIcon Glyph="&#xE72B;" FontSize="16" /></Button>
                <TextBlock Grid.Column="1" Text="设置" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" AutomationProperties.HeadingLevel="Level1" />
                <TextBlock Grid.Column="2" Text="更改会自动保存" FontSize="12" Foreground="{ThemeResource MutedBrush}" VerticalAlignment="Center" />
            </Grid>
            <ScrollViewer x:Name="SettingsScrollViewer" Grid.Row="1" HorizontalScrollBarVisibility="Disabled" HorizontalScrollMode="Disabled" VerticalScrollBarVisibility="Visible" HorizontalContentAlignment="Stretch" ZoomMode="Disabled">
                <Grid Width="{Binding ViewportWidth, ElementName=SettingsScrollViewer}" Padding="22,20,22,22">
                    <StackPanel x:Name="SettingsContent" Spacing="22">
                        <InfoBar x:Name="SettingsErrorBanner" IsOpen="False" IsClosable="False" Severity="Error" Title="操作需要处理" />
                        <Grid ColumnSpacing="22">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="204" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <StackPanel Spacing="8" Margin="0,8,0,0"><TextBlock Text="应用更新" FontSize="16" FontWeight="SemiBold" /><TextBlock Text="从 GitHub 公开发行版获取更新。安装完成后会清理下载包。" FontSize="12" Foreground="{ThemeResource MutedBrush}" TextWrapping="Wrap" LineHeight="20" /></StackPanel>
                            <Border Grid.Column="1" Style="{StaticResource CardStyle}">
                                <StackPanel Spacing="14">
                                    <TextBlock x:Name="CurrentVersionText" Text="Airloom" FontSize="14" FontWeight="SemiBold" />
                                    <TextBlock x:Name="UpdateStatusText" Text="检查是否有可用的新版本。" FontSize="14" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" AutomationProperties.AutomationId="UpdateStatusText" />
                                    <ProgressBar x:Name="UpdateProgress" Minimum="0" Maximum="100" Visibility="Collapsed" Foreground="{ThemeResource InkBrush}" AutomationProperties.Name="更新下载进度" />
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Button x:Name="CheckUpdatesButton" Content="检查更新" Click="OnCheckUpdates" MinHeight="36" CornerRadius="18" AutomationProperties.AutomationId="CheckUpdatesButton" />
                                        <Button x:Name="InstallUpdateButton" Content="下载并安装" Click="OnInstallUpdate" Style="{StaticResource PrimaryButtonStyle}" Visibility="Collapsed" />
                                        <Button x:Name="CancelUpdateButton" Content="取消" Click="OnCancelUpdate" Visibility="Collapsed" Style="{StaticResource SubtleButtonStyle}" />
                                        <HyperlinkButton Content="版本说明" NavigateUri="https://github.com/chummumm/airloom/releases/latest" Foreground="{ThemeResource InkBrush}" />
                                    </StackPanel>
                                    <TextBlock Text="安装前会停止传输并退出 Airloom，完成后重新打开。" FontSize="12" Foreground="{ThemeResource MutedBrush}" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </Grid>
                        <Grid ColumnSpacing="22">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="204" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <StackPanel Spacing="8" Margin="0,8,0,0"><TextBlock Text="连接诊断" FontSize="16" FontWeight="SemiBold" /><TextBlock Text="排查已连接但无声、音量与接收端兼容性问题。" FontSize="12" Foreground="{ThemeResource MutedBrush}" TextWrapping="Wrap" LineHeight="20" /></StackPanel>
                            <Border Grid.Column="1" Style="{StaticResource CardStyle}">
                                <StackPanel Spacing="12">
                                    <TextBlock Text="包含版本、采集电平和协议状态，不包含设备名称、网络地址或凭据。" FontSize="12" Foreground="{ThemeResource MutedBrush}" TextWrapping="Wrap" LineHeight="20" />
                                    <Button x:Name="CopyDiagnosticsButton" Content="复制诊断信息" Click="OnCopyDiagnostics" IsEnabled="False" MinHeight="36" CornerRadius="18" HorizontalAlignment="Left" AutomationProperties.Name="复制诊断信息" AutomationProperties.AutomationId="CopyDiagnosticsButton" />
                                    <TextBlock x:Name="DiagnosticsCopyStatus" Text="复制后可粘贴到 GitHub 问题反馈或聊天中。" FontSize="12" Foreground="{ThemeResource MutedBrush}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
                                </StackPanel>
                            </Border>
                        </Grid>
                        <Grid ColumnSpacing="22">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="204" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <StackPanel Spacing="8" Margin="0,8,0,0"><TextBlock Text="外观与启动" FontSize="16" FontWeight="SemiBold" /><TextBlock Text="沿用 Windows 的主题与动效偏好，或选择适合你的外观。" FontSize="12" Foreground="{ThemeResource MutedBrush}" TextWrapping="Wrap" LineHeight="20" /></StackPanel>
                            <Border Grid.Column="1" Style="{StaticResource CardStyle}">
                                <StackPanel Spacing="20">
                                    <Grid ColumnSpacing="16"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="188" /></Grid.ColumnDefinitions><TextBlock Text="应用主题" VerticalAlignment="Center" /><ComboBox x:Name="ThemePicker" Grid.Column="1" HorizontalAlignment="Stretch" SelectionChanged="OnThemeChanged" AutomationProperties.Name="应用主题"><ComboBoxItem Content="跟随 Windows" /><ComboBoxItem Content="浅色" /><ComboBoxItem Content="深色" /></ComboBox></Grid>
                                    <Grid ColumnSpacing="16"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="52" /></Grid.ColumnDefinitions><StackPanel Spacing="4"><TextBlock Text="动态波形" /><TextBlock Text="关闭后仍显示实际声道电平" FontSize="12" Foreground="{ThemeResource MutedBrush}" /></StackPanel><ToggleSwitch x:Name="VisualizerToggle" Grid.Column="1" OnContent="" OffContent="" MinWidth="0" Width="52" VerticalAlignment="Center" Toggled="OnVisualizerChanged" AutomationProperties.Name="动态波形" /></Grid>
                                    <Grid ColumnSpacing="16"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="52" /></Grid.ColumnDefinitions><StackPanel Spacing="4"><TextBlock Text="登录 Windows 后启动" /><TextBlock Text="在托盘中待命，不自动连接设备" FontSize="12" Foreground="{ThemeResource MutedBrush}" /></StackPanel><ToggleSwitch x:Name="StartupToggle" Grid.Column="1" OnContent="" OffContent="" MinWidth="0" Width="52" VerticalAlignment="Center" Toggled="OnStartupChanged" AutomationProperties.Name="登录 Windows 后启动" /></Grid>
                                </StackPanel>
                            </Border>
                        </Grid>
                        <Grid ColumnSpacing="22">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="204" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <StackPanel Spacing="8" Margin="0,8,0,0"><TextBlock Text="设备显示" FontSize="16" FontWeight="SemiBold" /><TextBlock Text="隐藏不常用的设备。离线设备也可以在这里恢复显示。" FontSize="12" Foreground="{ThemeResource MutedBrush}" TextWrapping="Wrap" LineHeight="20" /><TextBlock Text="隐藏正在使用的设备会停止向它传输。" FontSize="12" Foreground="{ThemeResource MutedBrush}" TextWrapping="Wrap" LineHeight="20" /></StackPanel>
                            <Border Grid.Column="1" Style="{StaticResource CardStyle}">
                                <StackPanel Spacing="14">
                                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock x:Name="VisibilitySummary" FontSize="12" Foreground="{ThemeResource MutedBrush}" VerticalAlignment="Center" /><Button Grid.Column="1" Content="重新发现" Click="OnRefresh" Style="{StaticResource SubtleButtonStyle}" /></Grid>
                                    <StackPanel x:Name="DeviceVisibilityList" Spacing="4" />
                                    <TextBlock x:Name="VisibilityEmptyText" Text="尚未发现设备。连接同一网络后，点击“重新发现”。" FontSize="12" Foreground="{ThemeResource MutedBrush}" TextWrapping="Wrap" LineHeight="20" />
                                </StackPanel>
                            </Border>
                        </Grid>
                        <Grid ColumnSpacing="22">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="204" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <StackPanel Spacing="8" Margin="0,8,0,0"><TextBlock Text="关于 Airloom" FontSize="16" FontWeight="SemiBold" /><TextBlock Text="开源的原生 Windows 音频投放工具。" FontSize="12" Foreground="{ThemeResource MutedBrush}" TextWrapping="Wrap" LineHeight="20" /></StackPanel>
                            <Border Grid.Column="1" Style="{StaticResource CardStyle}">
                                <StackPanel Spacing="14">
                                    <TextBlock Text="关闭窗口后可在托盘中继续运行。选择退出会结束当前传输。" FontSize="12" Foreground="{ThemeResource MutedBrush}" TextWrapping="Wrap" LineHeight="20" />
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <Button x:Name="ForgetButton" IsEnabled="False" Click="OnForgetCredentials" MinHeight="36" CornerRadius="18"><TextBlock x:Name="ForgetLabel" Text="忘记设备凭据" MaxWidth="180" TextTrimming="CharacterEllipsis" FontSize="13" /></Button>
                                        <Button Content="退出 Airloom" Click="OnExitClick" MinHeight="36" CornerRadius="18" AutomationProperties.AutomationId="ExitButton" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>
                </Grid>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
